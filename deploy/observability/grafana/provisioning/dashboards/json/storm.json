{
  "uid": "supernova-storm",
  "title": "Supernova — Storm",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "supernova-timescale" },
        "definition": "SELECT run_id FROM runs ORDER BY started_at DESC",
        "query": "SELECT run_id FROM runs ORDER BY started_at DESC",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Fleet QPS — $run",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "supernova-timescale" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "supernova-timescale" },
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 second', ts) AS time, count(*) AS qps FROM samples WHERE metric = 'latency_ms' AND run_id = '$run' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99 — $run",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "supernova-timescale" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "supernova-timescale" },
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time_bucket('5 seconds', ts) AS time, percentile_cont(0.50) WITHIN GROUP (ORDER BY value) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY value) AS p95, percentile_cont(0.99) WITHIN GROUP (ORDER BY value) AS p99 FROM samples WHERE metric = 'latency_ms' AND run_id = '$run' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ]
    }
  ]
}