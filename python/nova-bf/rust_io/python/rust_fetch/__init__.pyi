from collections.abc import Sequence
from typing import Any

__version__: str

class Client:
    def __init__(
        self,
        region: str | None = None,
        concurrency: int = 64,
        part_size: int = 16 << 20,
        connect_timeout_s: float = 5.0,
        part_timeout_s: float = 60.0,
        retries: int = 5,
        endpoint: str | None = None,
        allow_http: bool | None = None,
        threads: int | None = None,
    ) -> None: ...
    @property
    def concurrency(self) -> int: ...
    @property
    def part_size(self) -> int: ...
    def size(self, url: str) -> int: ...
    def head(self, url: str) -> tuple[int, str | None]: ...
    def cancel(self) -> None: ...
    def read_into(self, url: str, dest: Any, offset: int = 0, length: int | None = None) -> int: ...
    def read_ranges_into(self, url: str, dest: Any, ranges: Sequence[tuple[int, int, int]], if_match: str | None = None) -> int: ...
    def dense_plan(self, url: str, column: str, size: int | None = None) -> DensePlan: ...
    def read_dense_into(self, plan: DensePlan, dest: Any, chunks_in_flight: int = 8) -> int: ...

class DensePlan:
    @property
    def url(self) -> str: ...
    @property
    def column(self) -> str: ...
    @property
    def n_rows(self) -> int: ...
    @property
    def dim(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def column_bytes(self) -> int: ...
    @property
    def num_row_groups(self) -> int: ...
    @property
    def codec(self) -> str: ...
    @property
    def etag(self) -> str | None: ...

class UnsupportedLayout(ValueError): ...
class CorruptParquet(OSError): ...

def read_dense(
    client: Client, url: str, column: str, size: int | None = None,
    chunks_in_flight: int = 8, out: Any = None,
) -> Any: ...
